#include <windows.h>
#include "resource.h"

/////////////////////////////////////////////////////////////////////////////
// Icons
//
// IDI_APP must come first: the shell shows the lowest-numbered icon resource
// as the executable's icon in Explorer.

IDI_APP     ICON    "res\\app.ico"
IDI_PULSE1  ICON    "res\\pulse1.ico"
IDI_PULSE2  ICON    "res\\pulse2.ico"
IDI_PULSE3  ICON    "res\\pulse3.ico"
IDI_PULSE4  ICON    "res\\pulse4.ico"

/////////////////////////////////////////////////////////////////////////////
// Settings dialog

IDD_SETTINGS DIALOGEX 0, 0, 330, 296
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "TermLaunch Settings"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "Programs and folders", IDC_GRP_PATHS, 7, 4, 316, 72

    LTEXT           "&Terminal program (KiTTY or PuTTY):", IDC_LBL_TERMINAL, 15, 18, 200, 8
    EDITTEXT        IDC_TERMINAL_PATH, 15, 28, 246, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "B&rowse...", IDC_TERMINAL_BROWSE, 266, 27, 49, 16

    LTEXT           "&Sessions folder:", IDC_LBL_SESSIONS, 15, 48, 200, 8
    EDITTEXT        IDC_SESSIONS_DIR, 15, 58, 246, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "Br&owse...", IDC_SESSIONS_BROWSE, 266, 57, 49, 16

    GROUPBOX        "Speeds", IDC_GRP_SPEEDS, 7, 82, 316, 62

    LTEXT           "Baud rates offered in the tray menu (comma separated):", IDC_LBL_SPEED_LIST, 15, 96, 290, 8
    EDITTEXT        IDC_SPEED_LIST, 15, 106, 300, 14, ES_AUTOHSCROLL

    LTEXT           "&Default speed:", IDC_LBL_DEFAULT_SPEED, 15, 128, 55, 8
    COMBOBOX        IDC_DEFAULT_SPEED, 73, 126, 76, 120, CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP

    GROUPBOX        "Defaults for newly created session files", IDC_GRP_SERIAL, 7, 150, 316, 60

    LTEXT           "Data bits:", IDC_LBL_DATA_BITS, 15, 168, 34, 8
    COMBOBOX        IDC_DATA_BITS, 52, 166, 38, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Stop bits:", IDC_LBL_STOP_BITS, 100, 168, 33, 8
    COMBOBOX        IDC_STOP_BITS, 136, 166, 40, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Parity:", IDC_LBL_PARITY, 186, 168, 24, 8
    COMBOBOX        IDC_PARITY, 213, 166, 60, 90, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "Flow control:", IDC_LBL_FLOW_CONTROL, 15, 190, 44, 8
    COMBOBOX        IDC_FLOW_CONTROL, 62, 188, 76, 90, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    GROUPBOX        "Behaviour", IDC_GRP_BEHAVIOUR, 7, 216, 316, 56

    CONTROL         "Start &automatically on logon", IDC_RUN_ON_LOGON,
                    "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 15, 230, 145, 10
    CONTROL         "A&nimate the icon when a port appears", IDC_ANIMATE,
                    "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 168, 230, 148, 10
    CONTROL         "&Grey out ports already in use", IDC_DETECT_BUSY,
                    "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 15, 243, 145, 10
    CONTROL         "Show device &names in the menu", IDC_SHOW_FRIENDLY,
                    "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 168, 243, 148, 10

    LTEXT           "Checking whether a port is in use opens it briefly, which resets some boards.",
                    IDC_LBL_BUSY_HINT, 15, 257, 300, 8

    LTEXT           "", IDC_INI_PATH, 7, 278, 205, 16

    DEFPUSHBUTTON   "OK", IDOK, 218, 277, 50, 16
    PUSHBUTTON      "Cancel", IDCANCEL, 273, 277, 50, 16
END

/////////////////////////////////////////////////////////////////////////////
// Version

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Kasenberg"
            VALUE "FileDescription", "TermLaunch - serial port launcher for KiTTY and PuTTY"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "termlaunch"
            VALUE "LegalCopyright", "Copyright (C) 2026 Kasenberg"
            VALUE "OriginalFilename", "termlaunch.exe"
            VALUE "ProductName", "TermLaunch"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

/////////////////////////////////////////////////////////////////////////////
// Strings

STRINGTABLE
BEGIN
    IDS_APP_NAME    "TermLaunch"
END
